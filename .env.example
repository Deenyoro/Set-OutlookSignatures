# ================================================================
#  KawaSig Platform — Environment Configuration
# ================================================================
#  Copy to .env and fill in. Shared by sig-deployer and sig-relay.
#  cp .env.example .env && nano .env
# ================================================================

# ---- Entra ID / Graph API ----
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_SECRET=your-client-secret-value-here

# ---- Domains the platform manages ----
# Comma-separated. Relay processes mail from these domains; deployer pushes
# signatures to users in these domains.
MANAGED_DOMAINS=treconstruction.net,kawaconnect.com

# ---- Signature marker ----
# Full marker format: <!--KAWASIG:domain.com-->
SIG_MARKER_PREFIX=KAWASIG

# ---- sig-deployer (client-side push via Graph) ----
DEPLOY_CRON=*/30 * * * *
DEPLOY_DRY_RUN=false
DEPLOY_LOG_LEVEL=INFO

# ---- sig-relay (server-side fallback) ----
RELAY_HOSTNAME=mail-relay.treconstruction.net
RELAY_TLS_CERT=/etc/postfix/certs/fullchain.pem
RELAY_TLS_KEY=/etc/postfix/certs/privkey.pem
RELAY_SMTP_PORT=25

# Extra networks to treat as trusted (bypass sender-access + relay checks).
# Default is localhost + the first 4 common docker bridge subnets. Override
# here for Exchange Online CIDRs or a private network where postfix lives
# behind a proxy. Space-separated CIDRs.
#
# Production: firewall inbound port 25 to Microsoft EOP CIDRs at the OS/cloud
# level — mynetworks is NOT a replacement for a firewall. Messages from
# managed domains are accepted regardless of IP via check_sender_access, so
# mynetworks only matters for non-managed senders (bounces, tests).
#
# POSTFIX_MYNETWORKS=127.0.0.0/8 [::1]/128 172.17.0.0/16

# accept   = deliver without signature on milter failure (SAFE, recommended)
# tempfail = 4xx, Exchange retries (RISKY if relay stays down)
MILTER_FAIL_ACTION=accept

# Maximum message size the relay accepts (bytes). Exchange Online caps at
# 150 MB (= 157286400 bytes); match it by default to avoid silent rejection.
# MAX_MESSAGE_SIZE=157286400

# ---- Redis (Graph profile cache) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_TTL=3600

# ---- Optional alerting ----
ALERT_WEBHOOK_URL=
ALERT_EMAIL=dean@kawaconnect.com
